{
  "version": 2,
  "builds": [
    {
      "src": "src/runtime-server/server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/runtime-server/server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "src/runtime-server/server/index.js"
    }
  ],
  "env": {
    "KV_REST_API_URL": "@kv-rest-api-url",
    "KV_REST_API_TOKEN": "@kv-rest-api-token"
  }
}
