{
  "version": 2,
  "outputDirectory": ".",
  "installCommand": "npm install && node scripts/update-obsidian-mobile.js && cd src/runtime-server/server && npm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{vendor,src/client-mobile,src/plugins,src/config}/**"
    }
  },
  "redirects": [
    { "source": "/", "destination": "/vault/9e5a814a277ce6c4/00%20Dashboard/Welcome", "permanent": true }
    { "source": "/vault/0000demo0000demo", "destination": "/vault/9e5a814a277ce6c4/00%20Dashboard/Welcome", "permanent": true }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
