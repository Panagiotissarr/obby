{
  "version": 2,
  "builds": [
    {
      "src": "src/runtime-server/server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/runtime-server/server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "src/runtime-server/server/index.js"
    }
  ],
  "env": {
    "UPSTASH_REDIS_REST_URL": "@upstash-redis-rest-url",
    "UPSTASH_REDIS_REST_TOKEN": "@upstash-redis-rest-token"
  }
}
