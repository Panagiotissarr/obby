{
  "version": 2,
  "outputDirectory": ".",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{vendor,src/client-mobile,src/plugins,src/config}/**"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
